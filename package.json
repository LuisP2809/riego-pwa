{
  "name": "riego-pwa",
  "version": "0.1.9",
  "private": true,
  "type": "module",
  "description": "Riego de campo: Humedades, Compactación, Presiones, gráficas y mapa.",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "node --test scripts/backend.test.cjs",
    "android:init": "npm run build && cap add android && node scripts/configure-android.mjs && cap sync android",
    "android:sync": "npm run build && node scripts/configure-android.mjs && cap sync android",
    "apk:debug": "node scripts/build-apk.mjs debug",
    "apk:release": "node scripts/build-apk.mjs release"
  },
  "dependencies": {
    "@capacitor/android": "8.4.2",
    "@capacitor/core": "8.4.2",
    "@capacitor/app": "^8.0.0",
    "@capacitor/barcode-scanner": "^3.0.0",
    "@capacitor/filesystem": "8.1.2",
    "@capacitor/share": "8.0.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "leaflet": "1.9.4",
    "lucide-react": "^1.31.0",
    "qrcode": "1.5.4",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@capacitor/cli": "8.4.2",
    "@tailwindcss/postcss": "4.2.1",
    "@types/leaflet": "^1.9.22",
    "@types/node": "22.19.19",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
